{
	"name": "obsidian-proposal",
	"version": "1.0.0",
	"description": "Review proposed Markdown edits and comments before applying them to notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "tsx --test tests/*.test.ts",
		"test:obsidian": "tsx tests/obsidian-smoke.ts"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/merge": "^6.12.2",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6"
	}
}
